{
  "name": "brainmail-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "node --import tsx scripts/worker.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests db docs *.json *.ts *.md *.yaml .github/workflows/*.yml"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
