# Production Railway: variables privées, jamais NEXT_PUBLIC_* pour les secrets.
APP_URL=https://app.brainmail.ai
DATABASE_URL=
# Pilote privé : emails autorisés, séparés par des virgules. Vide = inscriptions fermées.
SIGNUP_EMAIL_ALLOWLIST=
# Générer : openssl rand -base64 32. Conserver hors Git avec la sauvegarde.
STORAGE_ENCRYPTION_KEY=
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Railway Buckets utilise les URL virtual-hosted : laisser false.
S3_FORCE_PATH_STYLE=false
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
OPENROUTER_API_KEY=
# Choisir un modèle disponible dans votre compte supportant json_schema.
OPENROUTER_MODEL=
RESEND_API_KEY=
RESEND_FROM=
RESEND_INBOUND_ENABLED=false
RESEND_INBOUND_DOMAIN=in.brainmail.ai
RESEND_WEBHOOK_SECRET=
# Hôtes exacts des URL de téléchargement Resend, après inspection dans votre compte.
# Aucun wildcard : les redirections et les autres hôtes sont refusés.
RESEND_ATTACHMENT_HOSTS=
MEM0_API_KEY=
# Développement seulement. Jamais true sur Railway.
LOCAL_DEV=false
LOCAL_DB_PATH=.data/postgres
LOCAL_STORAGE_PATH=.data/files
# Réservé pour la phase abonnements, pas de paiement actif dans ce MVP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
